# Copy to .env only when no .env exists. Never commit secrets.
DATABASE_URL=postgresql://itrade:itrade_local@127.0.0.1:54329/itrade
REDIS_URL=redis://127.0.0.1:63799
APP_ORIGIN=http://127.0.0.1:3000
HEALTH_INTERVAL_MS=10000
WORKER_STALE_AFTER_MS=45000
# Settings can override model, daily budget and analysis intensity.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=45000
# Independent random 32-byte keys, each encoded as 64 hex characters.
CREDENTIAL_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
# Optional wallet RPC access. Add public addresses in Portfolio.
ALCHEMY_API_KEY=
HELIUS_API_KEY=
# Kraken keys are submitted in Portfolio, verified read-only, and encrypted in PostgreSQL.
# Web Push needs a VAPID pair plus a real operator mailto: or public HTTPS contact.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Licensed normalized feed contract: docs/providers.md.
ETF_FLOW_FEED_URL=
ETF_FLOW_API_KEY=
ETF_FLOW_LICENSE_CONFIRMED=false
FMP_API_KEY=
COINGECKO_DEMO_API_KEY=
CRYPTOPANIC_API_KEY=
CRYPTOPANIC_PLAN=developer
# Default 24 calls/day; raise interval to fit your plan's monthly quota.
CRYPTOPANIC_POLL_SECONDS=3600
# Remote origins always require HTTPS and authentication, regardless of this flag.
REQUIRE_AUTH=false
LOGIN_PASSWORD_HASH=
SESSION_SECRET=
# Deployment-only Compose variables.
ITRADE_DOMAIN=
POSTGRES_PASSWORD=
# Optional maintenance windows in days; 7–3650. Preview with npm run retention -- --dry-run.
RETENTION_FINE_CANDLE_DAYS=90
RETENTION_NEWS_DAYS=180
RETENTION_SNAPSHOT_DAYS=365
RETENTION_DELIVERY_DAYS=90
