{
  "name": "itrade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "tsx src/worker/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:routes": "node tests/routes-live.mjs",
    "test:load": "node tests/load-live.mjs",
    "check:readiness": "tsx scripts/readiness.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:verify": "tsx scripts/backup.ts --verify",
    "retention": "tsx scripts/retention.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bullmq": "^5.81.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "fast-xml-parser": "^5.11.2",
    "ioredis": "^5.11.1",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
